DJANGO_SECRET_KEY=dev-secret-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# From Supabase Project Settings -> Database -> Connection pooling.
# Port 5432 = session mode. Deliberately NOT the 6543 transaction-mode
# pooler: our Row-Level Security policies read Postgres session state
# (app.current_user_id, set once per request by
# apps.common.middleware.CurrentCompanyMiddleware) that only stays
# reliable when a client connection is pinned to one backend Postgres
# process for its duration — which session mode guarantees and
# transaction mode does not. See docs/ARCHITECTURE.md for the RLS design
# this depends on.
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres

# The role docker/postgres/supabase_init.sql creates — NOT your
# project's main `postgres` role/password. Format is <role>.<project-ref>,
# same pattern Supabase uses for the `postgres` user itself.
DB_USER=coreerp_app.ppkzdxfajmfmnzqkebvp
DB_PASSWORD=the-password-you-set-in-supabase_init.sql

# Supabase requires TLS.
DB_SSLMODE=require

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
